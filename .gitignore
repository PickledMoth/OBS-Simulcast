# CMake build tree (regenerated by `cmake -B build`)
/build/
/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
*.dir/

# Visual Studio user/workspace cache
.vs/
*.user
*.sdf
*.opensdf
*.suo
*.VC.db
*.VC.VC.opendb

# VS Code workspace cache (project has no committed settings to preserve)
.vscode/

# Kept locally to build releases from, not published in the public source
# tree -- prebuilt .exe installers are uploaded as GitHub Releases instead.
/installer/

# Local tool/session cruft
aqtinstall.log
*.log
.claude/

# Internal-only planning/notes docs (BUILDING.md, CHANGELOG.md,
# QA-CHECKLIST.md, script.md, etc.) -- not for the public repo
/Plan/

# Editor/OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Secrets/credentials -- should never exist in this repo, ignored defensively
# in case a local .env or key file ever gets created alongside the source
.env
.env.*
*.pem
*.pfx
*.key

